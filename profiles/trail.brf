# Trail Run: unbefestigte Wege und Pfade bevorzugt, Asphalt moeglichst vermeiden.
# Asphalt bleibt erlaubt (z. B. fuer den Weg aus dem Wohngebiet hinaus), kostet aber das Dreifache.

---context:global
assign validForFoot = true
assign hills = 1   # %hills% | 0 = flach bevorzugen, 1 = egal | number

assign downhillcost   = 0
assign downhillcutoff = 1.5
assign uphillcost     = if equal hills 0 then 40 else 0
assign uphillcutoff   = 2

assign turnInstructionMode = 0
assign considerTurnRestrictions = false
assign correctMisplacedViaPoints = true
assign correctMisplacedViaPointsDistance = 800
assign processUnusedTags = false

---context:way

assign isroad = highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|unclassified|residential|living_street|service|road
assign likelyasphalt =
  or surface=asphalt|paved
     and surface= or isroad and highway=track tracktype=grade1
assign pavedother = surface=concrete|paving_stones|sett|cobblestone|grass_paver|metal|wood
assign unpaved = surface=unpaved|gravel|ground|dirt|grass|compacted|sand|pebblestone|fine_gravel|earth|mud|clay|rock|stone

assign footaccess =
  switch foot=
    switch access=
      not or motorroad=yes highway=motorway|motorway_link|trunk|trunk_link
      not access=private|no
    not foot=private|no|use_sidepath

assign surfacefactor =
  if unpaved then ( if surface=gravel|compacted|fine_gravel then 1.2 else 1.0 )
  else if likelyasphalt then 4.5
  else if pavedother then 3.2
  else if surface= then
    ( if highway=path|track|bridleway then 1.0 else if highway=steps then 2.5 else 2.0 )
  else 2.0

assign roadfactor =
  if highway=primary|primary_link then 3
  else if highway=secondary|secondary_link then 2
  else if highway=tertiary|tertiary_link then 1.5
  else if highway=unclassified then 1.2
  else 1.0

assign trailpenalty =
  if trail_visibility=bad|horrible|no then 1.5
  else 1.0

assign forbidden =
  or not footaccess
  or highway=
  or highway=motorway|motorway_link|trunk|trunk_link|construction|proposed|abandoned|raceway
     sac_scale=alpine_hiking|demanding_alpine_hiking|difficult_alpine_hiking

assign turncost = 0
assign initialcost = 0
assign costfactor =
  if forbidden then 10000
  else min 9999 multiply trailpenalty multiply surfacefactor roadfactor

---context:node

assign initialcost =
  if and access=private|no not foot=yes|designated|permissive then 1000000
  else 0
